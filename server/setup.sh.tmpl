#!/bin/sh
# Make-It-Safer server setup (format 1). See docs/design.md §4.1.
#
# Creates a read-only "mis" user that can only run the collector:
#   - no password, key login only, no sudo, no groups
#   - home owned by root, so it can't add keys or files
#   - sshd forces the collector: no shell, no terminal, no forwarding
# Safe to run again. If a check fails, or the session drops or is stopped
# (HUP, INT, TERM), the changes made by this run are rolled back. On a repeat
# run the user already exists and is kept; the key, collector and sshd
# settings are rewritten with the same values.
set -eu
umask 022

MIS_USER=mis
MIS_HOME=/var/lib/mis
LIB_DIR=/usr/local/lib/mis
COLLECT=$LIB_DIR/collect
MARKER=$MIS_HOME/.managed-by-make-it-safer
MAIN=/etc/ssh/sshd_config
DROPIN=/etc/ssh/sshd_config.d/50-mis.conf
KEY_LINE='restrict,command="/usr/local/lib/mis/collect" {{.PublicKey}}'
COLLECTOR_B64='{{.Collector}}'
BLOCK='# Managed by Make-It-Safer: the "mis" user can only run the read-only collector.
# Remove with: mis server remove <name>
Match User mis
    ForceCommand /usr/local/lib/mis/collect
    AuthenticationMethods publickey
    DisableForwarding yes
    PermitTTY no
    PermitUserRC no'

say() { printf 'mis-setup: %s\n' "$*"; }
fail() { printf 'mis-setup: ERROR: %s\n' "$*" >&2; exit 1; }

# matches WORD "PATTERNS": does one of the space-separated patterns match
# WORD? sshd's Allow*/Deny* lists understand only * and ?; a "!" is an
# ordinary character there, not a negation. In a user@host pattern only the
# user part is compared. The unquoted patterns are meant to be split and to glob.
# shellcheck disable=SC2086,SC2254
matches() {
    m_word=$1
    m_found=1
    set -f # keep * and ? from expanding to file names
    for m_pat in $2; do
        m_pat=${m_pat%%@*}
        case $m_word in $m_pat) m_found=0; break ;; esac
    done
    set +f
    return $m_found
}

# check_access: sshd's login rules for the mis user, read from MIS_SETTINGS
# (the "sshd -T" lines for mis) and MIS_GROUPS. As in sshd, a matching Deny*
# entry blocks the login, and an Allow* list that is set must have a match.
check_access() {
    ca_allow_users=$(printf '%s\n' "$MIS_SETTINGS" | sed -n 's/^allowusers //p')
    ca_deny_users=$(printf '%s\n' "$MIS_SETTINGS" | sed -n 's/^denyusers //p')
    ca_allow_groups=$(printf '%s\n' "$MIS_SETTINGS" | sed -n 's/^allowgroups //p')
    ca_deny_groups=$(printf '%s\n' "$MIS_SETTINGS" | sed -n 's/^denygroups //p')
    if [ -n "$ca_allow_users" ] && ! matches "$MIS_USER" "$ca_allow_users"; then
        fail "your sshd AllowUsers setting doesn't include '$MIS_USER'; add it and run this again"
    fi
    if [ -n "$ca_deny_users" ] && matches "$MIS_USER" "$ca_deny_users"; then
        fail "your sshd DenyUsers setting blocks '$MIS_USER'"
    fi
    ca_ok=no
    for ca_group in $MIS_GROUPS; do
        if [ -n "$ca_deny_groups" ] && matches "$ca_group" "$ca_deny_groups"; then
            fail "your sshd DenyGroups setting blocks the '$ca_group' group of '$MIS_USER'"
        fi
        if matches "$ca_group" "$ca_allow_groups"; then ca_ok=yes; fi
    done
    if [ -n "$ca_allow_groups" ] && [ "$ca_ok" = no ]; then
        fail "your sshd AllowGroups setting doesn't include the '$MIS_USER' group; add it and run this again"
    fi
}

[ "$(id -u)" -eq 0 ] || fail "must run as root"
grep -Eq '^ID="?(ubuntu|debian)"?$' /etc/os-release || fail "only Ubuntu and Debian are supported"
SSHD=$(command -v sshd || echo /usr/sbin/sshd)
[ -x "$SSHD" ] || fail "the OpenSSH server (sshd) was not found"
if id "$MIS_USER" >/dev/null 2>&1 && [ ! -e "$MARKER" ]; then
    fail "a user named '$MIS_USER' already exists and wasn't created by Make-It-Safer; nothing was changed"
fi

# Effective sshd settings for a user, used to prove nobody else is affected.
probe() { "$SSHD" -T -C "user=$1,host=mis-probe,addr=127.0.0.1" 2>/dev/null; }
reload_sshd() {
    if command -v systemctl >/dev/null 2>&1 && systemctl is-active --quiet ssh 2>/dev/null; then
        systemctl reload ssh
    elif command -v systemctl >/dev/null 2>&1 && systemctl is-active --quiet sshd 2>/dev/null; then
        systemctl reload sshd
    elif [ -f /run/sshd.pid ]; then
        kill -HUP "$(cat /run/sshd.pid)"
    else
        say "sshd isn't running; it will use the new settings when it starts"
    fi
}

ADMIN=${SUDO_USER:-}
BEFORE_ROOT=$(probe root) || fail "cannot read the current sshd settings"
BEFORE_ADMIN=""
if [ -n "$ADMIN" ] && [ "$ADMIN" != root ]; then BEFORE_ADMIN=$(probe "$ADMIN"); fi

CREATED_USER=no
DROPIN_STATE=none   # none | new | replaced
MAIN_BACKUP=""
rollback() {
    set +e # keep undoing even if a step fails or the terminal is gone
    trap '' HUP INT TERM PIPE
    say "something went wrong; undoing the changes"
    case $DROPIN_STATE in
        new) rm -f "$DROPIN" ;;
        replaced) mv -f "$DROPIN.mis-bak" "$DROPIN" ;;
    esac
    if [ -n "$MAIN_BACKUP" ]; then mv -f "$MAIN_BACKUP" "$MAIN"; fi
    if [ "$CREATED_USER" = yes ]; then
        userdel "$MIS_USER" >/dev/null 2>&1 || true
        rm -rf "$MIS_HOME" "$LIB_DIR"
    fi
    reload_sshd || true
}
on_exit() {
    status=$?
    if [ "$status" -ne 0 ]; then rollback; fi
}
# dash runs the EXIT trap on exit and INT but not when HUP or TERM kill it,
# so turn those signals into a normal exit.
trap 'exit 1' HUP INT TERM
trap on_exit EXIT

# 1. The user: no password, no groups, home owned by root.
if ! id "$MIS_USER" >/dev/null 2>&1; then
    useradd --system --user-group --home-dir "$MIS_HOME" --no-create-home --shell /bin/sh "$MIS_USER"
    CREATED_USER=yes
fi
usermod -p '*' -G '' "$MIS_USER"
install -d -o root -g root -m 0755 "$MIS_HOME" "$MIS_HOME/.ssh"
: > "$MARKER"
printf '%s\n' "$KEY_LINE" > "$MIS_HOME/.ssh/authorized_keys.new"
chmod 0644 "$MIS_HOME/.ssh/authorized_keys.new"
mv -f "$MIS_HOME/.ssh/authorized_keys.new" "$MIS_HOME/.ssh/authorized_keys"
[ "$(id -Gn "$MIS_USER")" = "$MIS_USER" ] || fail "the $MIS_USER user is in other groups"

# 2. The collector: root-owned, read-only for everyone else.
install -d -o root -g root -m 0755 "$LIB_DIR"
printf '%s' "$COLLECTOR_B64" | base64 -d > "$COLLECT.new"
chmod 0755 "$COLLECT.new"
mv -f "$COLLECT.new" "$COLLECT"

# 3. sshd: a drop-in file, or a marked block at the end of sshd_config.
if grep -Eqi '^[[:space:]]*Include[[:space:]]+/etc/ssh/sshd_config\.d/\*\.conf' "$MAIN"; then
    if [ -f "$DROPIN" ]; then cp -p "$DROPIN" "$DROPIN.mis-bak"; DROPIN_STATE=replaced; else DROPIN_STATE=new; fi
    printf '%s\n' "$BLOCK" > "$DROPIN.new"
    chmod 0644 "$DROPIN.new"
    mv -f "$DROPIN.new" "$DROPIN"
else
    cp -p "$MAIN" "$MAIN.mis-bak" || { rm -f "$MAIN.mis-bak"; fail "cannot back up $MAIN"; }
    MAIN_BACKUP=$MAIN.mis-bak # set only once the copy is complete, so a rollback never restores a partial file
    sed -i '/^# BEGIN make-it-safer$/,/^# END make-it-safer$/d' "$MAIN"
    printf '\n# BEGIN make-it-safer\n%s\n# END make-it-safer\n' "$BLOCK" >> "$MAIN"
fi

# 4. Prove it: valid config, nobody else affected, mis fully restricted.
"$SSHD" -t || fail "the new sshd settings are invalid"
[ "$(probe root)" = "$BEFORE_ROOT" ] || fail "the change would alter root's SSH settings"
if [ -n "$BEFORE_ADMIN" ]; then
    [ "$(probe "$ADMIN")" = "$BEFORE_ADMIN" ] || fail "the change would alter $ADMIN's SSH settings"
fi
MIS_SETTINGS=$(probe "$MIS_USER")
for want in "forcecommand $COLLECT" "authenticationmethods publickey" "disableforwarding yes" "permittty no" "permituserrc no"; do
    printf '%s\n' "$MIS_SETTINGS" | grep -qix "$want" || fail "sshd does not apply '$want' to the $MIS_USER user"
done
MIS_GROUPS=$(id -Gn "$MIS_USER")
check_access

reload_sshd
trap - EXIT HUP INT TERM
rm -f "$DROPIN.mis-bak" "${MAIN_BACKUP:-/nonexistent}"
say "done: the '$MIS_USER' user can only run the read-only collector"
